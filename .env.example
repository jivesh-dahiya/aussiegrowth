# Copy these into Vercel → Project → Settings → Environment Variables. NEVER commit real values.
DATABASE_URL=postgres://user:pass@host/db?sslmode=require   # Vercel Postgres / Neon / Supabase connection string
ADMIN_EMAIL=you@yourdomain.com.au
ADMIN_PASSWORD_HASH=      # run: node scripts/hash-password.js
SESSION_SECRET=           # 32+ random chars (the script above prints one)
